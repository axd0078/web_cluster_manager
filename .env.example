WCM_PUBLIC_HOST=wcm.internal.example
WCM_BOOTSTRAP_ADMIN_USERNAME=admin

# Secure file transfer defaults
WCM_MAX_UPLOAD_BYTES=104857600
WCM_FILE_CHUNK_BYTES=524288
WCM_MAX_TRANSFER_TARGETS=32
WCM_FILE_TRANSFER_CONCURRENCY=4
WCM_FILE_UPLOAD_PARTIAL_TTL_HOURS=24
WCM_FILE_UPLOAD_RETENTION_HOURS=168

# Trusted Agent updates. The Docker deployment mounts this public-key
# directory read-only; never place the offline signing private key here.
WCM_UPDATE_TRUSTED_KEYS_DIR=/run/secrets/update_keys
WCM_UPDATE_CHUNK_BYTES=524288
WCM_UPDATE_TRANSFER_CONCURRENCY=4
WCM_UPDATE_TRANSFER_TIMEOUT_SECONDS=30
WCM_UPDATE_HEALTH_TIMEOUT_SECONDS=120
WCM_UPDATE_MAX_ENTRIES=10000
WCM_UPDATE_MAX_EXPANDED_BYTES=524288000
WCM_UPDATE_MAX_TARGETS=32

# Terminal features are disabled until Agent/Broker rollout is complete.
WCM_ENABLE_LOW_TERMINAL=false
WCM_ENABLE_PRIVILEGED_TERMINAL=false
WCM_TERMINAL_TICKET_TTL_SECONDS=60
WCM_TERMINAL_IDLE_TIMEOUT_SECONDS=600
WCM_TERMINAL_MAX_LIFETIME_SECONDS=1800
WCM_TERMINAL_MAX_GLOBAL_PRIVILEGED=16
