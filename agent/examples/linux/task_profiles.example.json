{
  "version": 2,
  "log_profiles": {
    "application": {
      "root": "/var/log/my-application",
      "patterns": [
        "*.log",
        "*.log.*"
      ]
    }
  },
  "backup_profiles": {
    "application-data": {
      "root": "/srv/my-application/data"
    }
  },
  "service_profiles": {
    "web": {
      "manager": "systemd",
      "name": "nginx.service"
    }
  },
  "command_profiles": {
    "uptime": {
      "argv": [
        "/usr/bin/uptime"
      ],
      "timeout": 15
    }
  },
  "terminal_profiles": {
    "system-summary": {
      "argv": [
        "/usr/bin/uname",
        "-a"
      ],
      "timeout": 15,
      "output_limit": 65536
    },
    "disk-usage": {
      "argv": [
        "/usr/bin/df",
        "-h"
      ],
      "timeout": 30,
      "output_limit": 262144
    }
  }
}
